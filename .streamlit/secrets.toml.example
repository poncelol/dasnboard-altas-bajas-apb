# Copia este archivo como .streamlit/secrets.toml (NO lo subas a GitHub).
# Usa UNA de las tres opciones de [datos].

[app]
# Opcional: si lo dejas, la app pide contraseña al entrar.
password = "cambia-esta-contraseña"

[datos]
# Opción 1 (recomendada): el archivo comprimido dentro de secrets.
# Genéralo con:  python generar_secret.py CERVANTESG_CONSPREDEFINIDA.xls
archivo_b64 = "PEGA_AQUI_LA_SALIDA_DE_generar_secret.py"

# Opción 2: un enlace privado de descarga directa (+ token si lo requiere).
# url = "https://..."
# token = "..."

# Opción 3: solo para correrlo en tu equipo.
# ruta = "C:/Users/tu_usuario/Documents/CERVANTESG_CONSPREDEFINIDA.xls"
